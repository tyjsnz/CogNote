{
  "name": "cognote",
  "version": "1.0.0",
  "description": "Cognote — 私有化智能笔记与知识图谱",
  "main": "server.js",
  "bin": "server.js",
  "scripts": {
    "start": "node server.js",
    "rescan": "node scripts/rescan.js",
    "build": "pkg . --out-path dist"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "pkg": {
    "scripts": ["src/**/*.js"],
    "assets": ["public/**/*"],
    "targets": ["node22-win-x64"]
  },
  "license": "MIT"
}
